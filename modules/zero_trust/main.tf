# Zero-Trust Policy and Security subsystem entrypoint.
# Orchestrates RBAC matrices, JWT claim validation, microsegmentation, and secret rotation.

terraform {
  required_version = ">= 1.6.0"
  required_providers {
    local = {
      source  = "hashicorp/local"
      version = ">= 2.4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = ">= 3.5.0"
    }
    time = {
      source  = "hashicorp/time"
      version = ">= 0.10.0"
    }
  }
}
